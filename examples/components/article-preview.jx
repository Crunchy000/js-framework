<!-- article-preview.jx: one article in a list, as a web component.

     Both Conduit apps use it. They give it the same fields, from different places
     (a view API, and a GraphQL fragment):
       article: { slug, title, description, tagList, favoritesCount, favorited,
                  date, author: { username, image } }

     The heart button fires a "favorite" event. The component doesn't know what
     favouriting means: the page that uses it decides, with jx:trigger="favorite". -->
<template id="article-preview" props="article">
  <style>
    :host { display: block; padding: var(--wa-space-l) 0; border-bottom: var(--wa-border-width-s) solid var(--wa-color-surface-border); }
    a { color: inherit; text-decoration: none; }
    .row { display: flex; align-items: center; justify-content: space-between; gap: var(--wa-space-s); flex-wrap: wrap; }
    .author { display: inline-flex; align-items: center; gap: var(--wa-space-xs); }
    .author strong { color: var(--conduit-green, #5cb85c); }
    small { color: var(--wa-color-text-quiet); }
    .title { display: block; margin: var(--wa-space-s) 0; }
    h2 { margin: 0; font-size: var(--wa-font-size-xl); }
    p { margin: var(--wa-space-3xs) 0 0; color: var(--wa-color-text-quiet); }
    .more { font-size: var(--wa-font-size-s); color: var(--wa-color-text-quiet); }
    .more:hover { color: var(--conduit-green, #5cb85c); }
    .tags { display: flex; flex-wrap: wrap; gap: var(--wa-space-2xs); }
  </style>
  <jx-each items="article">
    <div class="row">
      <a class="author" href="profile.html?username={{author.username}}">
        <wa-avatar image="{{author.image}}" label="{{author.username}}"></wa-avatar>
        <span><strong>{{author.username}}</strong><br><small>{{date}}</small></span>
      </a>
      <jx-if test="favorited">
        <wa-button size="s" variant="success" jx:emit="favorite">
          <wa-icon slot="start" name="heart"></wa-icon>{{favoritesCount}}
        </wa-button>
      </jx-if>
      <jx-else>
        <wa-button size="s" variant="success" appearance="outlined" jx:emit="favorite">
          <wa-icon slot="start" name="heart" variant="regular"></wa-icon>{{favoritesCount}}
        </wa-button>
      </jx-else>
    </div>
    <a class="title" href="article.html?slug={{slug}}">
      <h2>{{title}}</h2>
      <p>{{description}}</p>
    </a>
    <div class="row">
      <a class="more" href="article.html?slug={{slug}}">Read more...</a>
      <div class="tags"><jx-each items="tagList"><wa-tag size="s" appearance="outlined">{{.}}</wa-tag></jx-each></div>
    </div>
  </jx-each>
</template>
