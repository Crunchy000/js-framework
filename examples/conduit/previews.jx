<!-- previews.jx: the list of article previews, shared by the home and profile pages.
     Each preview is an <article-preview> web component (see ../components/).
     It fires "favorite" when its heart is clicked, and here that posts to the
     article's favoriteUrl, which answers with this page's view again. -->
<template src="../components/article-preview.jx"></template>

<template id="previews">
  <if test="!articles">
    <p class="empty">No articles are here... yet.</p>
  </if>
  <each items="articles">
    <article-preview article="{{.}}" jx:post="{{favoriteUrl}}" jx:trigger="favorite"></article-preview>
  </each>
</template>
