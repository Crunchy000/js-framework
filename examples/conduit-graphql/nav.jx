<!-- nav.jx: the navigation bar, shared by every page with <template src="nav.jx">.
     It's a template with its own query, so it loads and draws itself. -->
<script type="text/graphql" id="nav-query">query Nav { viewer { username } }</script>

<header class="conduit-nav">
  <template jx:query="#nav-query">
    <nav class="wa-split">
      <a class="brand" href="index.html">conduit <small>graphql</small></a>
      <div class="wa-cluster wa-gap-l">
        <a href="index.html">Home</a>
        <if test="viewer">
          <a href="editor.html"><wa-icon name="pen-to-square"></wa-icon> New article</a>
          <a href="settings.html"><wa-icon name="gear"></wa-icon> Settings</a>
          <a href="profile.html?username={{viewer.username}}"><wa-icon name="user"></wa-icon> {{viewer.username}}</a>
        </if>
        <else>
          <a href="login.html">Sign in</a>
          <a href="register.html">Sign up</a>
        </else>
      </div>
    </nav>
  </template>
</header>
