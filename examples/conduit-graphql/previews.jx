<!-- previews.jx: the list of article previews, shared by the home and profile pages. -->
<template src="../components/article-preview.jx"></template>

  <!-- Article previews, shared by the page's template. Each is an <article-preview>
       web component (see ../components/), which fires "favorite" when its heart
       is clicked. Here that runs this page's #favorite or #unfavorite mutation,
       which asks for the page's #view again. -->
  <template id="previews">
    <jx-if test="!articles.nodes">
      <p class="empty">No articles are here... yet.</p>
    </jx-if>
    <jx-each items="articles.nodes">
      <jx-if test="favorited">
        <article-preview article="{{.}}" jx-trigger="favorite" jx-vals='{"slug": "{{slug}}"}'
                         jx-query="#unfavorite, #view, #preview-fields" jx-select="unfavoriteArticle.query"></article-preview>
      </jx-if>
      <jx-else>
        <article-preview article="{{.}}" jx-trigger="favorite" jx-vals='{"slug": "{{slug}}"}'
                         jx-query="#favorite, #view, #preview-fields" jx-select="favoriteArticle.query"></article-preview>
      </jx-else>
    </jx-each>
    <jx-if test="articles.pages">
      <div class="pages wa-cluster wa-gap-2xs">
        <jx-each items="articles.pages">
          <wa-button size="s" appearance="outlined" class:current="{{current}}"
                     jx-query="#query, #view, #preview-fields" jx-vals='{"offset": {{offset}}}'>{{number}}</wa-button>
        </jx-each>
      </div>
    </jx-if>
  </template>

  <script type="text/graphql" id="preview-fields">
    # Named the way <article-preview> expects (favorited, date).
    fragment Preview on Article {
      slug title description tagList favoritesCount
      favorited: viewerHasFavorited
      date: createdAt(format: LONG)
      author { username image }
    }
  </script>
