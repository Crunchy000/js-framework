<!-- widgets.jx: components with their own state, like hand-written Lit ones.

     A plain <script> inside a component is that component's code. It runs once
     for each element, so two counters count separately. Its variables and
     functions are what the template and jx-action see, with nothing to export, and
     the component's props are variables in it too. Functions called
     connected, disconnected and rendered run at those moments, and `el` is
     the element. jsonx redraws an element when its variables change. -->

<template id="my-counter" props="start:number step:number">
  <script>
    let count = start ?? 0;
    function up() { count += step ?? 1; }
    function down() { count -= step ?? 1; }
    function reset() { count = start ?? 0; }   // also el.reset() from outside
  </script>
  <style>
    :host { display: inline-flex; align-items: center; gap: 8px; }
    button { font: inherit; width: 36px; height: 36px; border-radius: 8px; border: 1px solid var(--line, #ddd); background: var(--panel, #fff); color: inherit; cursor: pointer; }
    output { min-width: 3ch; text-align: center; font-size: 20px; font-variant-numeric: tabular-nums; }
  </style>
  <button jx-action="down" aria-label="Down">−</button>
  <output>{{count}}</output>
  <button jx-action="up" aria-label="Up">+</button>
</template>

<template id="count-down" props="seconds:number">
  <script>
    let left = seconds ?? 10;
    let running = false;
    let done = false;
    let timer;

    function start() {
      if (running || left === 0) return;
      running = true;
      timer = setInterval(tick, 1000);
    }
    // A timer isn't an action, so it tells jsonx to look for changes.
    function tick() {
      left -= 1;
      if (left === 0) { stop(); done = true; }
      jsonx.changed();
    }
    function stop() { clearInterval(timer); running = false; }
    function again() { stop(); left = seconds ?? 10; done = false; start(); }

    function connected() { if (el.hasAttribute("autostart")) start(); }
    function disconnected() { stop(); }
  </script>
  <style>
    :host { display: inline-flex; align-items: center; gap: 10px; }
    .time { font-size: 28px; font-variant-numeric: tabular-nums; min-width: 2ch; }
    .done { color: #16a34a; }
    button { font: inherit; padding: 6px 12px; border-radius: 8px; border: 1px solid var(--line, #ddd); background: var(--panel, #fff); color: inherit; cursor: pointer; }
  </style>
  <span class="time" class:done="{{done}}">{{left}}</span>
  <jx-if test="running"><button jx-action="stop">Pause</button></jx-if>
  <jx-else-if test="done"><button jx-action="again">Again</button></jx-else-if>
  <jx-else><button jx-action="start">Start</button></jx-else>
</template>

<template id="star-rating" form>
  <script>
    let value = 0;
    let stars = [];
    show(0);

    function show(n) { stars = [1, 2, 3, 4, 5].map((i) => ({ id: i, n: i, on: i <= n })); }
    function pick({ n }) {
      value = Number(n);
      show(value);
      el.dispatchEvent(new Event("change", { bubbles: true })); // like an <input>
    }
    // jx-ref="stars" in the template: refs.stars is that element.
    function rendered() { refs.stars.setAttribute("aria-valuenow", value); }
  </script>
  <style>
    :host { display: inline-block; }
    button { font-size: 26px; line-height: 1; padding: 2px; border: 0; background: none; cursor: pointer; color: #d4d4d8; }
    button.on { color: #f59e0b; }
  </style>
  <span jx-ref="stars" role="slider" aria-valuemin="0" aria-valuemax="5" aria-label="Rating">
    <button jx-each="stars" class:on="{{on}}" jx-action="pick" jx-vals='{"n": {{n}}}' aria-label="{{n}} stars">★</button>
  </span>
</template>

<template id="feedback-form">
  <script>
    let sent = "";
    async function send(values) {
      await new Promise((done) => setTimeout(done, 300)); // a pretend server
      sent = "Thanks! You gave " + values.rating + " stars and said: " + (values.comment || "nothing");
    }
  </script>
  <style>
    form { display: grid; gap: 10px; max-width: 360px; }
    textarea { font: inherit; padding: 8px; border-radius: 8px; border: 1px solid var(--line, #ddd); background: var(--panel, #fff); color: inherit; }
    button { justify-self: start; font: inherit; padding: 8px 16px; border: 0; border-radius: 8px; background: var(--accent, #4f46e5); color: #fff; cursor: pointer; }
    .sent { color: #16a34a; margin: 0; }
  </style>
  <form jx-action="send" jx-swap="none">
    <star-rating name="rating"></star-rating>
    <textarea name="comment" rows="3" placeholder="Anything else?"></textarea>
    <button>Send feedback</button>
    <jx-if test="sent"><p class="sent">{{sent}}</p></jx-if>
  </form>
</template>
